---
import type { Fixture } from '../lib/fixtures';
interface Props { fixture: Fixture; }
const { fixture } = Astro.props;
const d = new Date(fixture.date);
const dateStr = d.toLocaleDateString('en-AU', { weekday: 'short', day: 'numeric', month: 'short' });
---
<div class="bg-white rounded-lg shadow-sm border border-slate-200 p-4">
  <div class="text-xs uppercase tracking-wider text-slate-500 mb-2">{fixture.competition ?? 'Match'}</div>
  <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2">
    <div class="font-semibold text-right whitespace-nowrap">{fixture.home}</div>
    <div class="text-slate-500">v</div>
    <div class="font-semibold whitespace-nowrap">{fixture.away}</div>
  </div>
  <div class="mt-3 text-sm text-slate-600 flex justify-between">
    <span>{dateStr}{fixture.bounce && ` · ${fixture.bounce}`}</span>
    {fixture.venue && <span class="truncate ml-2">{fixture.venue}</span>}
  </div>
</div>
