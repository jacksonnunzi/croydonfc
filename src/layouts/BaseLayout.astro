---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Croydon FNC - Croydon, Victoria',
  description = 'Official website of Croydon Football Netball Club. Fixtures, results, squad and news.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#0a1f5c" />
    {/* Open Graph / social preview */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Croydon FNC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://croydonfootballclub.com.au/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://croydonfootballclub.com.au/og-image.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;700&display=swap" rel="stylesheet" />
    <style is:inline>
      /* Hide the page behind a full-screen brand loader until everything is ready. */
      html.cfnc-loading body { visibility: hidden; }
      .cfnc-loader {
        position: fixed;
        inset: 0;
        background: #0a1f5c;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        visibility: visible;
      }
      html:not(.cfnc-loading) .cfnc-loader { display: none; }
      .cfnc-spinner {
        width: 56px;
        height: 56px;
        border: 5px solid rgba(255, 255, 255, 0.18);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: cfnc-spin 0.9s linear infinite;
      }
      @keyframes cfnc-spin {
        to { transform: rotate(360deg); }
      }
    </style>
    <script is:inline>
      // Start loading state before body parses.
      document.documentElement.classList.add('cfnc-loading');
      // Reveal after the window fully loads + 100ms buffer.
      window.addEventListener('load', function () {
        setTimeout(function () {
          document.documentElement.classList.remove('cfnc-loading');
        }, 100);
      });
      // Safety: never keep the page hidden longer than 2.5s.
      setTimeout(function () {
        document.documentElement.classList.remove('cfnc-loading');
      }, 2500);
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50">
    <div class="cfnc-loader" aria-hidden="true"><div class="cfnc-spinner"></div></div>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
