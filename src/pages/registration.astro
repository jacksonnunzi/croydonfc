---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Registration · Croydon FNC">
  <section class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="font-display text-4xl text-club-primary mb-4">Registration</h1>
    <p class="text-slate-700 mb-6">All player registration is handled through PlayHQ. Click below to register for the 2026 season.</p>

    <a href="https://www.playhq.com/afl/register/8d359d" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-club-primary text-white px-6 py-3 rounded font-semibold hover:opacity-90">
      Register on PlayHQ
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
    </a>

    <p class="text-sm text-slate-500 mt-6">Questions about registration? Get in touch via the <a href="/contact" class="text-club-primary underline">Contact</a> page.</p>
  </section>
</BaseLayout>
