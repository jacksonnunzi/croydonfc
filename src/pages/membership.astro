---
import BaseLayout from '../layouts/BaseLayout.astro';

---
<BaseLayout title="Membership · Croydon FNC">
  <!-- Page header -->
  <section class="bg-gradient-to-br from-club-primary to-club-dark text-white">
    <div class="max-w-6xl mx-auto px-4 py-14 md:py-20">
      <div class="text-xs uppercase tracking-[0.3em] text-white/70">Back the Blues</div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl tracking-widest mt-2">MEMBERSHIP</h1>
      <p class="mt-4 text-white/80 max-w-2xl">Every membership keeps grassroots footy and netball alive in Croydon. Join the Blues family for the 2026 season and help the next generation pull on the navy and white.</p>
    </div>
  </section>

  <!-- FAQ / info band -->
  <section class="bg-slate-100 border-y border-slate-200">
    <div class="max-w-4xl mx-auto px-4 py-12">
      <div class="text-xs uppercase tracking-[0.3em] text-club-secondary">Frequently asked</div>
      <h2 class="font-display text-3xl text-club-primary tracking-wide mt-1">MEMBERSHIP QUESTIONS</h2>
    </div>
  </section>
</BaseLayout>
