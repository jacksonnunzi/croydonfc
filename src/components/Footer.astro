---
const year = new Date().getFullYear();
---
<footer class="bg-gradient-to-br from-club-primary via-club-primary to-club-dark text-white/80 mt-16">
  <div class="max-w-6xl mx-auto px-4 py-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
    <div>
      <h3 class="font-display text-xl text-white mb-2 tracking-wide">Croydon FNC</h3>
      <p class="text-sm leading-relaxed">The Blues. Established 1906. Proudly representing Croydon in Division 2 of the Eastern Football Netball League.</p>
    </div>

    <div>
      <h4 class="font-display text-lg text-white mb-2 tracking-wide">Home ground</h4>
      <p class="text-sm leading-relaxed">
        <a
          href="https://www.google.com/maps/search/?api=1&query=Croydon+Park+Oval+Croydon+VIC+3136"
          target="_blank"
          rel="noopener"
          class="hover:text-club-secondary inline-flex items-start gap-1"
        >
          Croydon Park Oval<br />
          Croydon VIC 3136
        </a>
      </p>
      <p class="text-xs text-white/60 mt-2">PO Box 361, Croydon VIC 3136</p>
    </div>

    <div>
      <h4 class="font-display text-lg text-white mb-2 tracking-wide">Contact</h4>
      <ul class="text-sm space-y-1.5">
        <li>
          <a href="mailto:croydon@efnl.org.au" class="hover:text-club-secondary inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            croydon@efnl.org.au
          </a>
        </li>
        <li>
          <a href="tel:+61403816865" class="hover:text-club-secondary inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            0403 816 865
          </a>
        </li>
        <li class="flex items-center gap-3 pt-1">
          <a href="https://www.facebook.com/CroydonFootyClub" target="_blank" rel="noopener" aria-label="Facebook" class="hover:text-club-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
          </a>
          <a href="https://www.instagram.com/croydon_fc/" target="_blank" rel="noopener" aria-label="Instagram" class="hover:text-club-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h4 class="font-display text-lg text-white mb-2 tracking-wide">Club</h4>
      <ul class="text-sm space-y-1.5">
        <li><a href="/fixtures" class="hover:text-club-secondary">Fixture</a></li>
        <li><a href="/ladders" class="hover:text-club-secondary">Ladder</a></li>
        <li><a href="/squad" class="hover:text-club-secondary">Teams</a></li>
        <li><a href="/membership" class="hover:text-club-secondary">Membership</a></li>
        <li><a href="https://www.playhq.com/afl/register/8d359d" target="_blank" rel="noopener" class="hover:text-club-secondary">Registration ↗</a></li>
        <li><a href="/admin/index.html" class="hover:text-club-secondary text-white/50">Editor login</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 text-center text-xs py-4">© {year} Croydon Football Netball Club · The Blues · Est. 1906</div>
</footer>
