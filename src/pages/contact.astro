---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact · Croydon FNC">
  <section class="bg-gradient-to-br from-club-primary to-club-dark text-white">
    <div class="max-w-6xl mx-auto px-4 py-14 md:py-20">
      <div class="text-xs uppercase tracking-[0.3em] text-white/70">Reach out</div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl tracking-widest mt-2">CONTACT</h1>
      <p class="mt-4 text-white/80 max-w-2xl">New players, supporters, sponsors and volunteers are always welcome at Croydon FNC. Get in touch with the club using the details below.</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-14">
    <div class="grid sm:grid-cols-2 gap-8">
      <div class="space-y-6">
        <div>
          <div class="font-display text-lg text-club-primary">Home ground</div>
          <div class="text-slate-700">Croydon Park</div>
          <div class="text-slate-700">Croydon VIC 3136</div>
        </div>
        <div>
          <div class="font-display text-lg text-club-primary">Email</div>
          <div><a class="text-club-primary hover:underline" href="mailto:croydon@efnl.org.au">croydon@efnl.org.au</a></div>
        </div>
        <div>
          <div class="font-display text-lg text-club-primary">Key contacts</div>
          <div class="text-slate-700">Anthony Thompson - President</div>
          <div class="text-slate-700">Jackie Clark - Secretary</div>
        </div>
      </div>
      <div class="space-y-6">
        <div>
          <div class="font-display text-lg text-club-primary">Post</div>
          <div class="text-slate-700">PO Box 361, Croydon VIC 3136</div>
        </div>
        <div>
          <div class="font-display text-lg text-club-primary">Social</div>
          <div><a class="text-club-primary hover:underline" href="https://www.facebook.com/CroydonFootyClub">facebook.com/CroydonFootyClub</a></div>
          <div><a class="text-club-primary hover:underline" href="https://www.instagram.com/croydon_fc/">instagram.com/croydon_fc</a></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
